+               "è local_nli_forward_mean; sono riportati anche reverse e minimo delle due direzioni. "
+               "Coseno e BERTScore sono distinti fra documento e frase alterata. BERTScore qui usa lo stesso protocollo "
+               "non riscalato del run storico, per un confronto omogeneo.", "",
+               "## Distribuzione delle categorie", "", table(pd.DataFrame(distribution)), "",
+               "La politica clean limita le categorie e può modificare più menzioni coreferenti. "
+               "Non certifica la coreferenza o la verità dei fatti; le corruzioni restano condizioni sperimentali.", "",
+               "## Riproduzione", "", "```bash", ".venv/bin/python scripts/compare_entity_policy.py", "```", ""]
+    (output/"entity_policy_comparison.md").write_text("\n".join(report).rstrip()+"\n")
+    manifest = {"unchanged_nonentity_input_pairs": len(ids), "unchanged_metric_columns": len(invariant),
+                "semantic_metrics_unchanged_within_tolerance": True, "atol": args.atol, "rtol": args.rtol,
+                "runtime_counters_excluded": sorted(COUNTERS), "coverage": coverage,
+                "comparison_uses_common_sources": True, "bootstrap": args.bootstrap,
+                "labels_are_not_gold_semantic_annotations": True}
+    (output/"entity_policy_comparison_manifest.json").write_text(json.dumps(manifest, indent=2)+"\n")
+    print(json.dumps(manifest, indent=2))
+
